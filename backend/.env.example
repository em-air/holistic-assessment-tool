# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Email Service (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Backend Sentry (Optional - production observability)
# If SENTRY_DSN is empty, backend error reporting is disabled.
SENTRY_DSN=
# Example: production, preview, development
SENTRY_ENVIRONMENT=development
# Value between 0 and 1 (lower is cheaper); default in code is 0.05
SENTRY_TRACES_SAMPLE_RATE=0.05
# Release identifier shown in Sentry
SENTRY_RELEASE=0.0.0

# Supabase Storage
REPORTS_BUCKET=reports

# Redis Configuration (Optional - for production session storage)
# If not set, in-memory storage will be used (suitable for development)
# REDIS_URL=redis://localhost:6379
# SESSION_STORAGE=auto  # Options: 'auto', 'redis', 'memory'
