{
  "name": "holistic-assessment-backend",
  "version": "1.0.0",
  "description": "Node.js/Express backend for Holistic Assessment Tool",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.js",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed-quizzes.ts",
    "seed:admins": "tsx scripts/seed-admins.ts",
    "seed:students": "tsx scripts/seed-students.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.52.1",
    "arabic-reshaper": "^1.1.0",
    "compression": "^1.7.4",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "pdfkit": "^0.15.0",
    "pino": "^10.3.1",
    "redis": "^4.6.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/connect-timeout": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pdfkit": "^0.13.4",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
