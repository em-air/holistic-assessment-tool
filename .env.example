# ===========================================
# Holistic Assessment Tool - Frontend Environment
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Supabase Configuration (Required)
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Base Path (Required for GitHub Pages)
# Use '/' for root deployment, '/your-repo-name' for GitHub Pages
VITE_BASE_PATH=/holistic-assessment-tool

# Backend API URL (Required for full functionality)
# Development: http://localhost:3001
# Production: https://your-railway-app.railway.app
VITE_API_URL=http://localhost:3001

# Frontend Sentry (Optional - production observability)
# If VITE_SENTRY_DSN is empty, Sentry is disabled in the browser.
VITE_SENTRY_DSN=
# Example: production, preview, development
VITE_SENTRY_ENVIRONMENT=development
# Value between 0 and 1 (lower is cheaper); default in code is 0.05
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# App version shown in Sentry release metadata
VITE_APP_VERSION=0.0.0

# Build-time Sentry source map upload (Optional)
# Requires @sentry/vite-plugin plus Sentry org/project values in CI or shell.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
