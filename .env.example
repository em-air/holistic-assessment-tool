# ===========================================
# Holistic Assessment Tool - Frontend Environment
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Supabase Configuration (Required)
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Base Path (Required for GitHub Pages)
# Use '/' for root deployment, '/your-repo-name' for GitHub Pages
VITE_BASE_PATH=/holistic-assessment-tool

# Backend API URL (Required for full functionality)
# Development: http://localhost:3001
# Production: https://your-railway-app.railway.app
VITE_API_URL=http://localhost:3001
